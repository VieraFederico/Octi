# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Secrets must be at least 8 characters. Empty values count as missing.

# --- University LiteLLM proxy (all LLM + embedding calls go here) ---
# URL, key and model names are sent on the course channel. "/v1" is added automatically.
# Use the short model ids (e.g. gpt-5-mini), not the "openai/..." aliases.
LITELLM_BASE_URL=
LITELLM_API_KEY=
LLM_MODEL=gpt-5-mini
# Optional: more chat models offered in the composer's model picker (comma-separated, short ids).
# LLM_MODEL is always offered first and is the default.
# LLM_MODEL_CHOICES=gpt-5-chat,gpt-5
EMBEDDING_MODEL=text-embedding-3-small   # 1536 dimensions = EMBEDDING_DIMENSION
# Optional (defaults shown)
# EMBEDDING_DIMENSION=1536
# LLM_TEMPERATURE=0
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2          # 3 attempts in total

# --- LangSmith (tracing) --- https://smith.langchain.com -> Settings -> API Keys
# Keep tracing on: the assignment requires every agent run to be traced.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=           # required while LANGSMITH_TRACING=true
LANGSMITH_PROJECT=octi
# Region-specific API host; check the hostname you see in the browser after logging in.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Needed when the key can see more than one workspace (Settings -> Workspaces).
LANGSMITH_WORKSPACE_ID=

# --- Pinecone (vector DB) --- https://app.pinecone.io -> API Keys
PINECONE_API_KEY=
PINECONE_INDEX_NAME=octi-tables   # lowercase letters, digits and "-" only
# PINECONE_NAMESPACE=octi

# --- Logging ---
# LOG_LEVEL=INFO             # DEBUG, INFO, WARNING or ERROR
